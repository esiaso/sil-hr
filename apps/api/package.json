{
  "name": "@sil/hr-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:worker": "node dist/src/worker.js",
    "dev": "node --env-file-if-exists=../../.env --watch -r ts-node/register/transpile-only src/main.ts",
    "dev:worker": "node --env-file-if-exists=../../.env --watch -r ts-node/register/transpile-only src/worker.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typeorm": "node --env-file-if-exists=../../.env -r ts-node/register/transpile-only ./node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "db:migrate": "pnpm typeorm migration:run",
    "db:migrate:prod": "typeorm -d dist/src/database/data-source.js migration:run",
    "db:seed": "node --env-file-if-exists=../../.env -r ts-node/register/transpile-only src/database/seeds/run-seed.ts",
    "db:seed:prod": "node dist/src/database/seeds/run-seed.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand test/unit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^11.0.0",
    "@sil/hr-shared": "workspace:*",
    "argon2": "^0.44.0",
    "bullmq": "^5.34.0",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.9.0",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.2",
    "jose": "^5.10.0",
    "multer": "^2.0.0",
    "nodemailer": "^7.0.0",
    "otplib": "^12.0.1",
    "pg": "^8.16.0",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "~0.3.27",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": ".",
    "roots": [
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "globalSetup": "<rootDir>/test/global-setup.ts",
    "setupFiles": [
      "<rootDir>/test/env.ts"
    ],
    "testTimeout": 60000
  }
}
