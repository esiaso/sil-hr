# Copy to .env for local development (pnpm dev:api / dev:web). Every value has a
# development default in docker-compose.yml and apps/api/src/config/env.ts; with
# NODE_ENV=production the API refuses to start on the placeholder keys.
NODE_ENV=development
PORT=3310
DATABASE_URL=postgres://silhr:silhr_dev_password@localhost:55433/silhr
REDIS_URL=redis://localhost:6380/0
SEED_ON_START=true
SEED_DEFAULT_PASSWORD="Hospital#Dev2026"
JOBS_MODE=inline
PUBLIC_BASE_URL=http://localhost:3310
CORS_ORIGINS=http://localhost:3320
S3_ENDPOINT=http://localhost:9010
SMTP_URL=smtp://localhost:1026
LOG_LEVEL=info
# Web app (apps/web) talks to the API here:
HR_API_INTERNAL_URL=http://localhost:3310
# Production: generate each with  openssl rand -hex 32
# JWT_SIGNING_KEY=
# DATA_ENCRYPTION_KEY=
# BLIND_INDEX_KEY=
# Single sign-on with the development Keycloak (docker compose --profile sso up):
# OIDC_ISSUER=http://keycloak:8080/realms/sil-hr        (inside compose; http://localhost:8180/realms/sil-hr when the API runs on the host)
# OIDC_CLIENT_ID=sil-hr
# OIDC_CLIENT_SECRET=sil-hr-dev-client-secret
