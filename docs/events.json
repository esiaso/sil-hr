    "type": "hr.organisation.branch.created.v1",
    "version": 1,
    "description": "A branch (site) was created.",
    "subject": "branch id",
    "data_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "inactive"
          ]
        }
      },
      "required": [
        "id",
        "code",
        "name",
        "status"
      ],
      "additionalProperties": false
    },
    "example": {
      "id": "0199a6b0-0000-7000-8000-0000000000b1",
      "code": "MAIN",
      "name": "Main Hospital",
      "status": "active"
